<Project>
  <PropertyGroup>
    <RollForward>LatestMajor</RollForward>
    <EmitAssetsLogMessages>false</EmitAssetsLogMessages>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <!-- Fallback assembly references for environments where local NuGet cache is offline -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' and Exists('$(MSBuildThisFileDirectory)GOpsHub.API\bin\Debug\net8.0\MongoDB.Driver.dll')">
    <Reference Include="$(MSBuildThisFileDirectory)GOpsHub.API\bin\Debug\net8.0\*.dll"
               Exclude="$(MSBuildThisFileDirectory)GOpsHub.API\bin\Debug\net8.0\GOpsHub.*.dll">
      <Private>true</Private>
    </Reference>
    <Reference Include="$(MSBuildThisFileDirectory)GOpsHub.Tests\bin\Debug\net8.0\*.dll"
               Exclude="$(MSBuildThisFileDirectory)GOpsHub.Tests\bin\Debug\net8.0\GOpsHub.*.dll"
               Condition="'$(MSBuildProjectName)' == 'GOpsHub.Tests'">
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>