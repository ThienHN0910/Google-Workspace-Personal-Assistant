# Server Configuration
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_ISSUER=gopshub
JWT_AUDIENCE=gopshub-client
FRONTEND_URL=http://localhost:5173

# Database (MongoDB)
MONGODB_CONNECTION_STRING=mongodb://localhost:27017
MONGODB_DATABASE_NAME=gopshub

# Google Workspace OAuth2
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# AI Service (Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# Multi-Channel Alerting (Discord & Telegram)
ALERTING__DISCORDWEBHOOKURL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
