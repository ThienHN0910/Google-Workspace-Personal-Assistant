# Server Configuration
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_ISSUER=http://localhost:5000
JWT_AUDIENCE=http://localhost:5173
TOKEN_ENCRYPTION_KEY=your_token_encryption_key_32_chars!
ADMIN_EMAIL=your_admin_email@gmail.com
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Database (MongoDB)
MONGODB_CONNECTION_STRING=mongodb://localhost:27017
MONGODB_DATABASE_NAME=gopshub

# Google Workspace OAuth2
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google-callback

# AI Service (Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Multi-Channel Alerting (Discord & Telegram)
ALERTING_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ_example
TELEGRAM_CHAT_ID=1234567890
